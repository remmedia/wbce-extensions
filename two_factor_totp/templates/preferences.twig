<section class="totp-preferences-card content-box wbce-admin-card {{ status_class|e }}">
    <div class="totp-preferences-icon" aria-hidden="true"><span class="fa fa-shield"></span></div>
    <div class="totp-preferences-content"><div class="totp-preferences-heading"><h2>{{ title|e }}</h2><span class="totp-status">{{ status_text|e }}</span></div><p>{{ description|e }}</p></div>
    <div class="totp-preferences-action"><a class="totp-action-button button" href="{{ profile_url|e }}">{{ action_label|e }}</a></div>
</section>
