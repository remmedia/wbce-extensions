<noscript>{{ L_('TOOL_TXT:NOSCRIPT_MESSAGE') }}</noscript>
<div class="account-app" data-saving="{{ L_('TOOL_TXT:SAVING') }}" data-saved="{{ L_('TOOL_TXT:ASYNC_SAVED') }}" data-save-failed="{{ L_('TOOL_TXT:ASYNC_FAILED') }}">
    <header class="account-hero">
        <h2>{{ TOOL_NAME }}</h2>
        <p>{{ TOOL_DESCRIPTION }}</p>
    </header>
    <nav aria-label="{{ L_('TOOL_TXT:NAV_LABEL') }}">
        <ul class="account-tabs">
        {% for tab in TABS %}
            <li {{ tab.li_class }}><a class="tab{{ tab.a_class }}" href="{{ TOOL_URI }}&pos={{ tab.pos }}"><i class="fa fa-{{ tab.icon }}"></i> {{ tab.link_name }}</a></li>
        {% endfor %}
        </ul>
    </nav>
    <main class="account-content">
        {{ MESSAGE_BOX }}
        {% block content %}{% endblock %}
    </main>
    <div class="account-toast wbce-admin-toast" data-account-toast hidden aria-live="polite"></div>
</div>
<script>
(function(){
    'use strict';
    var app=document.querySelector('.account-app');
    if(!app||typeof window.fetch!=='function')return;
    function notify(message,error){var box=app.querySelector('[data-account-toast]');box.textContent=message;box.hidden=false;box.classList.toggle('is-error',!!error);clearTimeout(box._timer);box._timer=setTimeout(function(){box.hidden=true;},5000);}
    app.addEventListener('submit',function(event){
        var form=event.target.closest('.account-content .cpForm form');
        if(!form)return;
        event.preventDefault();
        var submitter=event.submitter||form.querySelector('[type="submit"]');
        var oldLabel=submitter?submitter.value||submitter.textContent:'';
        if(submitter){submitter.disabled=true;if('value' in submitter)submitter.value=app.dataset.saving;else submitter.textContent=app.dataset.saving;}
        fetch(form.action||window.location.href,{method:'POST',body:new FormData(form),credentials:'same-origin',headers:{'X-Requested-With':'XMLHttpRequest'}})
          .then(function(response){if(!response.ok)throw new Error(app.dataset.saveFailed);return response.text();})
          .then(function(html){var page=new DOMParser().parseFromString(html,'text/html'),fresh=page.querySelector('.account-content');if(!fresh)throw new Error(app.dataset.saveFailed);app.querySelector('.account-content').replaceWith(fresh);notify(app.dataset.saved,false);})
          .catch(function(error){if(submitter){submitter.disabled=false;if('value' in submitter)submitter.value=oldLabel;else submitter.textContent=oldLabel;}notify(error.message,true);});
    });
}());
</script>
