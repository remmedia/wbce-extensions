{% extends "framer.twig" %}
{% block content %}
<div class="account-overview-head"><p class="account-overview-copy"><b>{{ L_('TOOL_TXT:OVERVIEW_DESCRIPTION') }}</b></p><div class="account-overview-actions"><span class="account-count">{{ USERLIST|length }}</span>{% if CAN_CREATE_ACCOUNTS %}<a class="account-create-button" href="{{ CREATE_USER_URL }}"><i class="fa fa-user-plus" aria-hidden="true"></i>{{ L_('TOOL_TXT:CREATE_USER') }}</a>{% endif %}</div></div>
<div class="account-table-wrap">
<table class="tablesorter">
    <thead>
        <tr>			
            <th style="width:20px;"><small title="{{ L_('TOOL_TXT:USER_ID') }}">ID</small></th>			
            <th>{{ L_('TEXT:DISPLAY_NAME') }} <i>({{ L_('TEXT:USERNAME') }})</i></th>
            <th style="width:20px;">{{ L_('TEXT:LANGUAGE') }}</th>
            <th>{{ L_('TEXT:EMAIL') }}</th>
            <th>{{ L_('TOOL_TXT:GROUPS') }}</th>
            <th>{{ L_('TOOL_TXT:DATE_REGISTERED') }}</th>
            <th>{{ L_('TOOL_TXT:LATEST_LOGIN') }}</th>
            <th data-filter="false">{#{ L_('TEXT:ACTIVE') }#}</th>
            {% if CAN_MODIFY_ACCOUNTS %}
            <th data-sorter="false" data-filter="false"></th>
            {% endif %}
        </tr>
    </thead>
    <tbody>
        {% for rec in USERLIST %}
            <tr>
                <td style="text-align:right;"><small>{{ rec['user_id'] }}</small></td>
                <td>
                    <b class="account-user-badge">{{ rec['username'] }}</b>
                </td>
                <td style="text-align:center;">
                    <img src="{{ WB_URL }}/languages/{{ rec['language'] }}.png" /> <small>{{ rec['language'] }}</small>
                </td>
                <td><nobr><i class="fa fa-envelope-o account-muted"></i><small> {{ rec['email'] }}</small></nobr></td>
                <td>
                     {% for key, group_name in rec['groups'] %}
                        <nobr><span class="usergroup" title="{{ L_('TEXT:GROUP')}}-ID: {{key}}"><i class="fa fa-group account-muted"></i> {{ group_name }} [{{key}}]</span></nobr>
                     {% endfor %}
                </td>
                <td>
                    <i class="fa fa-1x fa-calendar{% if rec['signup_timestamp'] == '' %}-o account-muted{% endif %}"></i>&nbsp;
                    <small>{% if rec['signup_timestamp_formatted'] %}{{ rec['signup_timestamp_formatted'] }}{% else %}{{ L_('TOOL_TXT:NOT_AVAILABLE') }}{% endif %}</small><br />
                    <small class="account-muted"><nobr>{{ rec['reg_method'] }}</nobr></small>
                </td>
                <td>
                    <nobr><i class="fa fa-1x fa-calendar{% if rec['login_when'] == '' %}-o account-muted{% endif %}"></i> &nbsp;
                    <small>{% if rec['login_when_formatted'] %}{{ rec['login_when_formatted'] }}{% else %}{{ L_('TOOL_TXT:NOT_AVAILABLE') }}{% endif %}</small></nobr>
                </td>
                <td class="center">
                    <i class="fa fa-1x fa-user-circle{% if rec['active'] %}-o account-active{% else %} account-inactive{% endif %}"></i>
                </td>
                {% if CAN_MODIFY_ACCOUNTS %}
                    <td style="text-align:center;" valign="top">
                        {% if rec['user_id'] == 1 %}
                            {% if IS_SUPERADMIN %}
                            <a class="" href="{{ ADMIN_URL }}/preferences/" title="{{ L_('TEXT:MODIFY') }}" target="_blank"><i class="fa fa-pencil"></i></a>                                     
                            {% else %}
                            <!-- nothing to click -->  
                            {% endif %}
                        {% else %}
                            <a class="" href="{{ ADMIN_URL }}/users/users.php?user_id={{ getIDKEY(rec['user_id']) }}&modify=1" {{JS_ONCLICK}} title="{{ L_('TEXT:MODIFY') }} {{ L_('TEXT:USER') }}" target="_blank"><i class="fa fa-pencil"></i></a>
                        {% endif %}
                    </td>
                {% endif %}
            </tr>
        {% else %}
            <tr><td class="account-empty" colspan="{% if CAN_MODIFY_ACCOUNTS %}9{% else %}8{% endif %}"><i class="fa fa-users" aria-hidden="true"></i>{{ L_('TOOL_TXT:NO_USERS') }}</td></tr>
        {% endfor %}
    </tbody>
</table>
</div>
{% endblock %}
