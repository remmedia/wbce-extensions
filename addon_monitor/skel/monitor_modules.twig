{#
/**
 * WebsiteBaker CMS AdminTool: addonMonitor
 *
 * Template for the display of modules
 *
 *
 * @platform    CMS WebsiteBaker 2.8.x
 * @package     addonMonitor
 * @author      Christian M. Stefan (Stefek)
 * @copyright   Christian M. Stefan
 * @license     http://www.gnu.org/licenses/gpl-2.0.html
 */
#}
{% autoescape 'html' %}
<table cellpadding="3" cellspacing="0" class="select_types">

	<tr class="addon-type-row">
		<td colspan="2">
			<div>
				<label class="page_module" for="include_pages"><input id="include_pages" type="checkbox" checked="checked" /><span>{{ T.page_modules }}</span><sup>({{ count_pagemodules }})</sup></label>
				<label class="snippet_module" for="include_snippets"><input id="include_snippets" type="checkbox" checked="checked" /><span>{{ T.snippets }}</span><sup>({{ count_snippets }})</sup></label>
				<label class="tool_module" for="include_tools"><input id="include_tools" type="checkbox" checked="checked" /><span>{{ T.admin_tools }}</span><sup>({{ count_tools }})</sup></label>
				<label class="wysiwyg_module" for="include_wysiwygs"><input id="include_wysiwygs" type="checkbox" checked="checked" /><span>{{ T.editors }}</span><sup>({{ count_wysiwygeditors }})</sup></label>
			</div>
		</td>
	</tr>
	<tr class="addon-filter-row">
		<td>
			<fieldset>
				<legend>{{ T.filter_name }}</legend>
				<input class="filterinput" name="filter" id="filter_titles" value="" maxlength="30" size="30" type="text">
				<input class="clearbtn" id="clear_titles" type="submit" value="{{ T.clear }}"/>
			</fieldset>
		</td>
		<td>
			<fieldset>
				<legend>{{ T.filter_author }}</legend>
				<input class="filterinput" name="filter" id="filter_authors" value="" maxlength="30" size="30" type="text">
				<input class="clearbtn" id="clear_authors" type="submit" value="{{ T.clear }}"/>
			</fieldset>
		</td>
	</tr>
</table>
<table border="0" cellpadding="3" cellspacing="0" id="htmlgrid" class="amDashboard">
	<thead>
		<tr>
			<th title="{{ T.type }}" class="sort"><span>{{ T.type }}</span></th>
			<th class="sort"><span>{{ T.name }}</span></th>
			<th>{{ T.version }}</th>
			<th>{{ T.description }}</th>
			<th>{{ T.author }}</th>
			<th>{{ T.status }}</th>
			<th class="sort"><span>{{ T.active }}</span></th>
		</tr>
	</thead>
	<tbody>
	{%for addon in addons %}
		{# in the next line we set a TWIG variable for "status" #}
		{% set status = (addon.usage_active == 'Y' or addon.function == 'snippet' or addon.function == 'tool') ? 'active_1' : 'active_0' %}
		{% set function = (addon.function == 'tool') ? T.admin_tool : (addon.function == 'page' ? T.page_module : T.snippet) %}

		<tr id="addons_{{ addon.addon_id }}" class="row_{{ addon.function }} {{ status }}" rel="{{ addon.function }}">
			<td class="addon_icon">
				<div>
					{% if addon.icon %}
						<img src="{{ addon.icon }}" alt="{{ function }}" title="{{ function }}" width="48" />
					{% endif %}
					<br />
					{% if addon.function == 'snippet' %}{{ T.snippet }}
					{% elseif addon.function == 'tool' %}{{ T.admin_tool }}
					{% elseif addon.function == 'page' %}{{ T.page_module }}
					{% else %}{{ T.wysiwyg }}
					{% endif %}
				</div>
			</td>
			<td class="addon_name">{{ addon.name }}<br/><small><i>{{ addon.directory }}</i></small></td>
			<td class="addon_version">{{ addon.version }}</td>
			<td class="addon_description" data-label="{{ T.description }}"><div class="collapser">{{ addon.description }}</div></td>
			<td class="addon_author" data-label="{{ T.author }}">
				<ul class="authors">
				{% for author in addon.author|split(', ') %}
					<li>{{ author }}</li>
				{% endfor %}
				</ul>
			</td>
			<td class="addon-core-status" data-label="{{ T.status }}">
				{% if ACTIVATION_SUPPORTED %}
				<form method="post" action="{{ ACTIVATION_URL }}" class="addon-monitor-state-form">
					<span class="addon-monitor-ftan">{{ ACTIVATION_FTAN|raw }}</span>
					<input type="hidden" name="addon_monitor_action" value="toggle">
					<input type="hidden" name="module_directory" value="{{ addon.directory }}">
					<input type="hidden" name="enabled" value="{{ addon.core_enabled ? '0' : '1' }}">
					<label class="addon-monitor-switch" title="{{ addon.core_enabled ? T.deactivate : T.activate }}">
						<input type="checkbox" {{ addon.core_enabled ? 'checked' : '' }} {{ addon.directory == ADDON_MONITOR_DIR ? 'disabled' : '' }}>
						<span></span>
					</label>
					<small>{{ addon.core_enabled ? T.enabled : T.disabled }}</small>
				</form>
				{% else %}<small>{{ T.wbce17_only }}</small>{% endif %}
			</td>
			<td class="addon_activeNo">{% if (status == 'active_1') and (addon.function == 'page') %}1{% elseif (status == 'active_0') and (addon.function == 'page') %}3{% else %}2{% endif %}</td>
			<td class="addon_active" data-label="{{ T.usage }}">

				{% if addon.function == 'page' %}
					{% if addon.active_sections|length > 0 %}
						<ul class="using_sections">
						<li title="{{ T.used_in_sections }}">{{ addon.active_sections|length }}x</li>
						{% for sID, pID in addon.active_sections|sort %}
							<li title="{{ T.page_id }}: {{ pID }} / {{ T.section_id }}: {{ sID }}"><a href="{{ constant('WB_URL') }}/{{ constant('ADMIN_DIRECTORY') }}/pages/sections.php?page_id={{ pID }}#sid{{ sID }}" target="_blank" rel="noopener noreferrer">{{ pID }}&nbsp;<small>/{{ sID }}</small></a></li>
						{% endfor %}
						</ul>
					{% else %}
						<ul class="using_sections_null">
							<li title="{{ T.not_used_in_section }}">0x</li>
						</ul>
					{% endif %}
				{% elseif addon.function == 'wysiwyg' %}
					{% if (addon.directory == default_wysiwyg) %}
						<ul class="using_sections">
							<li>{{ T.default_editor }}</li>
						</ul>
					{% else %}
						<ul class="using_sections_null">
							<li title="{{ T.editor_not_used }}">{{ T.not_used }}</li>
						</ul>
					{% endif %}
				{% else %}
					<img title="{{ T.always_active }}" src="{{ICONS_DIR}}/{% if (status == 'active_1') %}active{% else %}inactive{% endif %}.png" alt="{{ T.status }}" />
				{% endif %}
			</td>
		</tr>
	{% endfor %}
	</tbody>
	<tfoot>
		<tr>
			<td colspan="8">
				<b>{{ T.installed_modules }}:</b> {{ addons|length }}  <br/>
				<span class="page_module">{{ count_pagemodules }} x <b>{{ T.page_modules }}</b></span>  <br/>
				<span class="tool_module">{{ count_tools }} x <b>{{ T.admin_tools }}</b></span>  <br/>
				<span class="snippet_module">{{ count_snippets }} x <b>{{ T.snippets }}</b></span>  <br/>
				<span class="wysiwyg_module">{{ count_wysiwygeditors }} x <b>{{ T.editors }}</b></span>
			</td>
		</tr>
	</tfoot>
</table>
{% endautoescape %}
