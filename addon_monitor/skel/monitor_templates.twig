{#
{{ dump() }}
#}
{% autoescape 'html' %}
<table cellpadding="3" cellspacing="0" class="select_types">
	<tr class="addon-type-row">
		<td colspan="2">
			<div>
				<label class="tool_module" for="include_themes"><input id="include_themes" type="checkbox" checked="checked" /><span title="{{ T.admin_theme_help }}">{{ T.admin_themes }}</span><sup>({{ count_acpthemes }})</sup></label>
                                <label class="page_module" for="include_templates"><input id="include_templates" type="checkbox" checked="checked" /><span>{{ T.page_templates }}</span><sup>({{ count_pagetemplates }})</sup></label>
			</div>
		</td>
	</tr>
	<tr class="addon-filter-row">
		<td>
			<fieldset>
				<legend>{{ T.filter_name }}</legend>
				<input class="filterinput" name="filter" id="filter_titles" value="" maxlength="30" size="30" type="text">
				<input class="clearbtn" id="clear_titles" type="submit" value="{{ T.clear }}"/>
			</fieldset>
		</td>
		<td>
			<fieldset>
				<legend>{{ T.filter_author }}</legend>
				<input class="filterinput" name="filter" id="filter_authors" value="" maxlength="30" size="30" type="text">
				<input class="clearbtn" id="clear_authors" type="submit" value="{{ T.clear }}"/>
			</fieldset>
		</td>
	</tr>
</table>
<table border="0" cellpadding="3" cellspacing="0" id="htmlgrid" class="amDashboard">
	<thead>
		<tr>
			<th title="{{ T.type }}" class="sort"><span>{{ T.type }}</span></th><th class="sort"><span>{{ T.name }}</span></th><th>{{ T.version }}</th><th>{{ T.description }}</th><th>{{ T.author }}</th><th class="sort"><span>{{ T.active }}</span></th>
		</tr>
	</thead>
	<tbody>
	{%for addon in addons %}
		{% set function = (addon.function == 'template' ? T.page_template : T.admin_theme) %}
		{% set row_class = (addon.function == 'template' ? 'page' : 'tool') %}

		<tr id="addons_{{ addon.addon_id }}" class="row_{{ row_class }}" rel="{{ addon.function }}">
			<td class="addon_icon">
				<div>
					{% if addon.icon %}
						<img src="{{ addon.icon }}" alt="{{ function }}" title="{{ function }}" width="144" />
					{% else %}
						<small>{{function}}</small>
					{% endif %}
					<br />
					{{function}}
				</div>
			</td>
			<td class="addon_name">
				{{ addon.name }}<br />
				<small><i>{{ addon.directory }}</i></small>
			</td>
			<td class="addon_version">{{ addon.version }}</td>
			<td class="addon_description" data-label="{{ T.description }}">
				{% if addon.description %}
					{{ addon.description }}
				{% else %}
					<i>{{ T.no_description }}</i>
				{% endif %}
			</td>
			<td class="addon_author" data-label="{{ T.author }}">
				<ul class="authors">
				{% for author in addon.author|split(', ') %}
					<li>{{ author }}</li>
				{% endfor %}
				</ul>
			</td>
			<td class="addon_active" data-label="{{ T.usage }}">
				<span class="addon-monitor-sort-value">{# hidden visually; retained for sorting #}
					{% if (addon.active == 'Y' or (addon.directory == constant('DEFAULT_TEMPLATE')) or (addon.directory == constant('DEFAULT_THEME'))) %}1{% else %}0{% endif %}
				</span>
				{% if addon.function == 'template' %}
					{% if (addon.active_pages|length > 0) or (addon.directory == constant('DEFAULT_TEMPLATE')) %}
						<ul class="using_sections">
						{% if addon.directory == constant('DEFAULT_TEMPLATE') %}
							<li>{{ T.default_template }}</li>
						{% else %}
							<li title="{{ T.used_on_pages }}">{{ addon.active_pages|length }}x</li>
							{% for pID in addon.active_pages %}
								<li title="{{ T.page_id }}: {{ pID }}"><a href="{{ constant('WB_URL') }}/{{ constant('ADMIN_DIRECTORY') }}/pages/settings.php?page_id={{ pID }}" target="_blank" rel="noopener noreferrer">{{ pID }}</a></li>
							{% endfor %}
						{% endif %}
						</ul>
					{% else %}
						<ul class="using_sections_null">
							<li title="{{ T.not_used_on_page }}">0x</li>
						</ul>
					{% endif %}
				{% else %}
					{% if addon.directory == constant('DEFAULT_THEME') %}
						<ul class="using_sections">
							<li>{{ T.default_theme }}</li>
						</ul>
					{% else %}
						<ul class="using_sections_null">
							<li>{{ T.not_used }}</li>
						</ul>
					{% endif %}
				{% endif %}
			</td>
		</tr>
	{% endfor %}
	</tbody>
	<tfoot>
		<tr>
			<td colspan="6">
				<b>{{ T.installed_templates }}:</b> {{ addons|length }}  <br/>
				<span class="page_module">{{ count_pagetemplates }} x <b>{{ T.page_templates }}</b></span><br/>
				<span class="tool_module">{{ count_acpthemes }} x <b>{{ T.admin_themes }}</b></span>
			</td>
		</tr>
	</tfoot>
</table>
{% endautoescape %}
